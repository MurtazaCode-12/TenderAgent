# ==============================================================================
# TenderOps AI (by MCodes) - Environment Variables Configuration
# ==============================================================================

# Next.js Application Public URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# Supabase Configuration (Auth, Database, Storage)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
# Service role key is required for Cron Ingestion Workers & AI Background pipelines (bypasses RLS safely)
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# ------------------------------------------------------------------------------
# AI / LLM Configuration (Vercel AI SDK)
# ------------------------------------------------------------------------------
# Provider choice: 'openai' or 'google'
AI_PROVIDER="google"
# Google Gemini API Key
GOOGLE_GENERATIVE_AI_API_KEY="your-gemini-api-key"
# OpenAI API Key (Alternative)
OPENAI_API_KEY="your-openai-api-key"

# ------------------------------------------------------------------------------
# WhatsApp SDR Engine (Meta WhatsApp Cloud API)
# ------------------------------------------------------------------------------
WHATSAPP_API_VERSION="v21.0"
WHATSAPP_PHONE_NUMBER_ID="your-phone-number-id"
WHATSAPP_BUSINESS_ACCOUNT_ID="your-business-account-id"
WHATSAPP_ACCESS_TOKEN="your-permanent-system-user-access-token"
WHATSAPP_WEBHOOK_VERIFY_TOKEN="tenderops-secure-verify-token-change-this"
WHATSAPP_APP_SECRET="your-meta-app-secret-for-hmac-verification"

# ------------------------------------------------------------------------------
# Fallback Email Delivery (Resend)
# ------------------------------------------------------------------------------
RESEND_API_KEY="re_your_resend_api_key"
RESEND_FROM_EMAIL="alerts@tenderops.ai"

# ------------------------------------------------------------------------------
# Rate Limiting & Caching (Upstash Redis)
# ------------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL="https://your-redis.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-redis-token"

# ------------------------------------------------------------------------------
# Security & Cron Secrets
# ------------------------------------------------------------------------------
CRON_SECRET="your-high-entropy-cron-secret-token"
ENCRYPTION_KEY="your-32-byte-hex-encryption-key-for-pii"
